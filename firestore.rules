rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.role == 'admin';
    }

    function isAssignedDriver(data) {
      return request.auth != null && data.assignedToUid == request.auth.uid;
    }

    function getCurrentUserData() {
      return request.auth == null
        ? null
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDriverNameMatch(data) {
      let currentUser = getCurrentUserData();
      let emailPrefix = request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.split('@')[0]
        : null;

      return request.auth != null && (
        (currentUser != null && currentUser.fullName != null && data.driverName == currentUser.fullName) ||
        (currentUser != null && currentUser.displayName != null && data.driverName == currentUser.displayName) ||
        (currentUser != null && currentUser.nickname != null && data.driverName == currentUser.nickname) ||
        (emailPrefix != null && data.driverName == emailPrefix)
      );
    }

    // 1. users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. jobs
    match /jobs/{jobId} {
      allow read: if isAdmin() || isAssignedDriver(resource.data) || isDriverNameMatch(resource.data);
      allow write: if isAdmin();
    }

    // 2.1 dashboard_metrics
    match /dashboard_metrics/{metricId} {
      allow read, write: if isAdmin();
    }

    // 2.2 fuel_prices
    match /fuel_prices/{priceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // 3. options
    match /options/{optionId} {
      allow read, write: if isAdmin();
    }

    // 4. today_jobs
    match /today_jobs/{jobId} {
      allow read: if isAdmin() || isAssignedDriver(resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAssignedDriver(resource.data) &&
         request.resource.data.assignedToUid == resource.data.assignedToUid &&
         request.resource.data.createdByUid == resource.data.createdByUid);
      allow delete: if isAdmin();
    }

    // 5. accounting_entries
    match /accounting_entries/{entryId} {
      allow read, write: if isAdmin();
    }
  }
}
